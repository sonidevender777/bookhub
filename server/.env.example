# Server
NODE_ENV=development
PORT=5000

# Database
# Local example:
MONGODB_URI=mongodb://127.0.0.1:27017/bookhub
# Atlas example:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bookhub?retryWrites=true&w=majority&appName=BookHubCluster

# Authentication - replace with a long, unique secret in every environment
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Client application origin
CLIENT_URL=http://localhost:5173
# Production example:
# CLIENT_URL=https://your-bookhub-frontend.example.com

# Demo configuration
# Keep true for college/demo mode. Set false only after adding a real payment gateway.
DEMO_PAYMENT_MODE=true

# Optional owner seed overrides. Leave unset to use the clearly labelled demo account.
# SEED_ADMIN_NAME=BookHub Owner
# SEED_ADMIN_EMAIL=owner@bookhub.test
# SEED_ADMIN_PASSWORD=OwnerPass123
